from PIL import Image, ImageDraw
import math, os

outdir = "/mnt/data"
def make_icon(size, path):
    img = Image.new("RGB", (size, size), "#8b5cf6")
    px = img.load()
    # Subtle purple gradient, consistent with Student Hub theme
    top = (139, 92, 246)
    bottom = (109, 40, 217)
    for y in range(size):
        t = y / max(1, size - 1)
        c = tuple(round(top[i] * (1-t) + bottom[i] * t) for i in range(3))
        for x in range(size):
            px[x, y] = c
    # Rounded-square transparent outside corners
    mask = Image.new("L", (size, size), 0)
    md = ImageDraw.Draw(mask)
    r = int(size * 0.20)
    md.rounded_rectangle((0, 0, size-1, size-1), radius=r, fill=255)
    img.putalpha(mask)
    d = ImageDraw.Draw(img)
    # Graduation cap, scaled to canvas
    cx = size * 0.5
    # top diamond
    diamond = [
        (size*0.14, size*0.39),
        (cx, size*0.23),
        (size*0.86, size*0.39),
        (cx, size*0.55)
    ]
    d.polygon(diamond, fill="white")
    # Cap base below diamond
    base = [
        (size*0.27, size*0.45),
        (cx, size*0.59),
        (size*0.73, size*0.45),
        (size*0.73, size*0.67),
        (cx, size*0.77),
        (size*0.27, size*0.67)
    ]
    d.polygon(base, fill=(245, 240, 255, 255))
    # Re-draw crisp front lower panel in white/lavender
    d.line((size*0.27, size*0.48, cx, size*0.62, size*0.73, size*0.48), fill="white", width=max(2, int(size*0.018)))
    # tassel cord and bead / tassel
    d.line((size*0.84, size*0.40, size*0.84, size*0.65), fill="white", width=max(2, int(size*0.022)))
    rr = size*0.035
    d.ellipse((size*0.84-rr, size*0.64-rr, size*0.84+rr, size*0.64+rr), fill="white")
    d.polygon([
        (size*0.82, size*0.67),
        (size*0.86, size*0.67),
        (size*0.89, size*0.79),
        (size*0.79, size*0.79)
    ], fill="white")
    img.save(path, "PNG", optimize=True)

make_icon(192, os.path.join(outdir, "icon-192.png"))
make_icon(512, os.path.join(outdir, "icon-512.png"))
print("Created icon-192.png (192×192) and icon-512.png (512×512).")

make_icon(152, os.path.join(outdir, "icon-152.png"))
